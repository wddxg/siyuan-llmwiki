# ============================================================
# SiYuan LLM Wiki — 环境变量配置
# 复制此文件为 .env 后修改
# ============================================================

# --- 思源笔记 UI ---
SIYUAN_HOST_PORT=6806
SIYUAN_ACCESS_AUTH_CODE=change-me

# --- 思源笔记 API ---
SIYUAN_TOKEN=change-me
SIYUAN_INTERNAL_URL=http://siyuan:6806
SIYUAN_DEFAULT_NOTEBOOK=
SIYUAN_PERMISSION_MODE=whitelist
SIYUAN_NOTEBOOK_ALLOWLIST=
SIYUAN_DELETE_SAFE_MODE=true
SIYUAN_DELETE_REQUIRE_CONFIRMATION=true

# --- MCP Server ---
MCP_HOST_PORT=31710
MCP_PORT=31710
MCP_AUTH_TOKEN=

# --- 时区 ---
TZ=Asia/Shanghai
PUID=1000
PGID=1001

# --- 向量检索（可选）---
MCP_EMBEDDING_ENABLED=false
MCP_EMBEDDING_PROVIDER=openai-compatible
MCP_EMBEDDING_BASE_URL=
MCP_EMBEDDING_API_KEY=
MCP_EMBEDDING_MODEL=
MCP_EMBEDDING_DIMENSIONS=0
MCP_EMBEDDING_TOP_K=8
MCP_EMBEDDING_CACHE_DIR=/app/temp/embeddings
